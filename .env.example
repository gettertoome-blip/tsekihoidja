# PostgreSQL connection string (required)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Demo mode (default: true). Shows demo credentials on the login page, sample
# receipts in the upload step and the manual expiry button, and seeds the demo
# household on first start. Set to "false" in production to disable all of it.
DEMO_MODE="true"

# Port the server listens on (set automatically by most hosts)
# PORT=3000
